{
  "private": false,
  "name": "maestro",
  "version": "0.3.0",
  "description": "Self-hosted, track-first companion app for a Navidrome library: flat single-track browsing with server-side sort/filter, bulk actions, name-based import through a pluggable download backend, cleanup of never-played tracks, and safe delete-to-trash.",
  "author": "Byurhan Nurula (https://github.com/byurhannurula)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t maestro:local .",
    "docker:run": "docker run --rm -p 4544:4544 --env-file .env maestro:local",
    "release:patch": "npm version patch -m 'release: v%s' && git push --follow-tags",
    "release:minor": "npm version minor -m 'release: v%s' && git push --follow-tags",
    "release:major": "npm version major -m 'release: v%s' && git push --follow-tags",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-virtual": "^3.14.6",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/byurhannurula/maestro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byurhannurula/maestro.git"
  },
  "bugs": {
    "url": "https://github.com/byurhannurula/maestro/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.0",
  "keywords": [
    "navidrome",
    "self-hosted",
    "music",
    "music-library",
    "music-manager",
    "subsonic",
    "homelab",
    "nextjs"
  ]
}
