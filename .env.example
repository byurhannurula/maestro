# ─────────────────────────────────────────────────────────────
# maestro configuration — every value is read from env.
# Copy the relevant keys into your stack's root .env (compose reads it).
# Nothing here has a hard-coded fallback secret.
# ─────────────────────────────────────────────────────────────

# --- Navidrome ---
# Inside the docker network use the service name; from host use its IP.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=

# --- Download backend (REST API) ---
DEEMIX_URL=http://deemix:6595
# Optional: auth token, only needed if you want the app to log the backend in programmatically.
DEEMIX_ARL=

# --- Shared volumes (paths INSIDE the container) ---
MUSIC_DIR=/music
TRASH_DIR=/trash

# --- App state ---
DATABASE_PATH=/data/maestro.db

# --- Caching ---
# How long Navidrome reads are cached (seconds); busted immediately on any
# in-app change (star/delete/playlist/import). Default 24h. Set 0 to disable.
CACHE_TTL_SECONDS=86400

# --- Import pipeline tuning ---
# Delay between download-backend requests (ms) to avoid upstream rate-limiting.
IMPORT_DELAY_MS=1500
# Per-track download timeout (ms).
IMPORT_TIMEOUT_MS=300000

# --- UI ---
# Default rows per page / initial fetch size (user can override in the UI).
DEFAULT_PAGE_SIZE=25

# --- Webhook ingest (Shazam / iOS Shortcut) ---
# Shared secret the Shortcut sends; leave blank to disable the webhook.
WEBHOOK_SECRET=
WEBHOOK_PLAYLIST=Shazam

# --- Server ---
PORT=4544
